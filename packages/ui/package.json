{
  "name": "@muliacode/ui",
  "version": "0.0.0",
  "description": "Brand-neutral Vue 3 components on the Utrecht CSS components and NL Design System tokens.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muliacode/design-system.git",
    "directory": "packages/ui"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./themes/neutral.css": "./dist/themes/neutral.css"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "styles.css",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && node scripts/build-theme.mjs",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "validate": "node scripts/validate-contrast.mjs",
    "test": "npm run validate && npm run test:schemes",
    "test:schemes": "node scripts/test-schemes.mjs"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@utrecht/component-library-css": "^9.0.15"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "playwright": "^1.64.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
