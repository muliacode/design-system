{
  "name": "@muliacode/ui",
  "version": "0.0.0",
  "description": "Brand-neutral Vue 3 components on the Utrecht CSS components and NL Design System tokens.",
  "license": "EUPL-1.2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muliacode/design-system.git",
    "directory": "packages/ui"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./themes/neutral.css": "./dist/themes/neutral.css"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "styles.css",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "prepublishOnly": "node scripts/check-publish.mjs && npm run build",
    "build": "vite build && vue-tsc -p tsconfig.build.json && node scripts/build-theme.mjs",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "validate": "node scripts/validate-contrast.mjs",
    "test": "npm run validate && npm run test:schemes && npm run test:unit",
    "test:unit": "node scripts/build-theme.mjs && vitest run",
    "test:schemes": "node scripts/build-theme.mjs && node scripts/test-schemes.mjs",
    "storybook": "node scripts/build-theme.mjs && storybook dev --port 6006",
    "build-storybook": "node scripts/build-theme.mjs && storybook build --output-dir storybook-static"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@utrecht/component-library-css": "^9.0.15"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/vue3-vite": "^10.6.2",
    "@testing-library/user-event": "^14.6.8",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "axe-core": "^4.14.0",
    "dom-accessibility-api": "^0.7.1",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "storybook": "^10.6.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "~5.0.4",
    "vitest-axe": "^0.1.0",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
